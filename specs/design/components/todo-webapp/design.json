{
  "name": "todo-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "todo-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4"
  ],
  "description": "Single-page React app: one screen with an add-todo field and the user's todo list, done items shown struck through. The only user-facing surface; holds no data or credentials and does not talk to the database.",
  "dependencies": [
    {
      "kind": "component",
      "name": "todo-api",
      "description": "Lists, adds and completes the signed-in user's todos.",
      "wiring": {
        "endpoint": {
          "component": "very-todo-just-2-todo-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TODO_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs users in via SSO (PKCE).",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "very-todo-just-2-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
